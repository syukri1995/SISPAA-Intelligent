APP_ENV=local
APP_NAME=SISPAA Intelligent GovTech Router

# Backend base URL (used for links)
PUBLIC_BASE_URL=http://localhost:8000

# Postgres
# TiDB (MySQL-compatible). Example:
# DATABASE_URL=mysql+aiomysql://USER:PASSWORD@HOST:4000/sispaa_router?charset=utf8mb4
DATABASE_URL=mysql+aiomysql://root:password@localhost:4000/sispaa_router?charset=utf8mb4

# Optional Redis (queue / cache)
REDIS_URL=redis://localhost:6379/0
ENABLE_REDIS_QUEUE=false

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000

# LLM (optional)
# If not set, the classifier falls back to heuristics.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

